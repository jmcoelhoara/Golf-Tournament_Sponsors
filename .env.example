# Supabase → Project Settings → API. Both values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Course branding on the plain /login page (slug from src/lib/course-brand.ts).
# Leave empty for Westwood Plateau, or set "none" for an unbranded sign-in.
# Every course also has its own page at /login/<slug>.
NEXT_PUBLIC_DEFAULT_COURSE=
