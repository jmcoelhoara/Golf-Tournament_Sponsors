# Supabase → Project Settings → API. Both values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Course branding on the plain /login page (slug from src/lib/course-brand.ts).
# Leave empty for Westwood Plateau, or set "none" for an unbranded sign-in.
# Every course also has its own page at /login/<slug>.
NEXT_PUBLIC_DEFAULT_COURSE=

# Staff invitations (server-only — set in Vercel, never with a NEXT_PUBLIC_ prefix, never commit real values).
# Supabase → Project Settings → API Keys → service_role / secret key. Leave unset to keep invitations switched off.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS app origin, no path, e.g. https://golfsponsors.vercel.app
STAFF_INVITE_SITE_URL=
